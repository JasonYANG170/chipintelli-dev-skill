/**
 * This is the configure demo  
 *    - CMAKEDEFINE_VAR1 = @CMAKEDEFINE_VAR1@
 *    - CMAKEDEFINE_VAR2 = @CMAKEDEFINE_VAR2@
 *    - DEFINE_VAR1      = @DEFINE_VAR1@
 *    - DEFINE_VAR2      = @DEFINE_VAR2@
 */

/**
 *  cmakedefine 会根据变量的值是否为真（类似 if）来变换为 #define VAR ... 或  #undef VAR 
 */
#cmakedefine CMAKEDEFINE_VAR1 @CMAKEDEFINE_VAR1@
#cmakedefine CMAKEDEFINE_VAR2 @CMAKEDEFINE_VAR2@

/**
 * define 会直接根据规则来替换
 */

#define CIAS_LN_HARDWARE_TEST_ENABLE  @CIAS_LN_HARDWARE_TEST_ENABLE@
#define CIAS_BLE_CONFIG_ENABLE        @CIAS_BLE_CONFIG_ENABLE@
#define CIAS_IOT_CLOUD_HISENSE_ENABLE @CIAS_IOT_CLOUD_HISENSE_ENABLE@
#define CIAS_IOT_CLOUD_HUAWEI         @CIAS_IOT_CLOUD_HUAWEI@
#define CIAS_IOT_CLOUD_XIAOMI_ENABLE  @CIAS_IOT_CLOUD_XIAOMI_ENABLE@
#define CIAS_IOT_CLOUD_CI_ENABLE      @CIAS_IOT_CLOUD_CI_ENABLE@
#define CIAS_IOT_TENCENT_ENABLE       @CIAS_IOT_TENCENT_ENABLE@
#define CIAS_IOT_TVS_ENABLE           @CIAS_IOT_TVS_ENABLE@
#define CIAS_IOT_TUYA_ENABLE          @CIAS_IOT_TUYA_ENABLE@
#define CIAS_IOT_CLOUD_ALI_ENABLE     @CIAS_IOT_CLOUD_ALI_ENABLE@
#define CIAS_AIOT_AUDIO_OTA_ENABLE    @CIAS_AIOT_AUDIO_OTA_ENABLE@
#define CIAS_AIOT_WIFI_OTA_ENABLE     @CIAS_AIOT_WIFI_OTA_ENABLE@
#define CIAS_TUYA_IR_CTRL_ENABLE      @CIAS_TUYA_IR_CTRL_ENABLE@
#define CIAS_AUDIO_SPEEX_ENABLE       @CIAS_AUDIO_SPEEX_ENABLE@
#define CIAS_SYSTEM_MANAGE_ENABLE     @CIAS_SYSTEM_MANAGE_ENABLE@


